# `make compile` is the harness compile check, and it runs nothing (the
# handler runs it before validation; a compile failure is Compile Error):
# the harness modules, then the solution against them, as the build
# does, into a temporary folder.
# The arena drives correctness/perf via selection/run_validate.sh +
# run_harness.sh — RUN_CMD mirrors them for the local `make` workflow.
LANG        = Elixir
TEST        = split-array-largest-sum
SOURCE      = solution.ex
OUTPUT      = .compile_check
ARG         =
SEL         = ../../../selection
RUN_CMD     = bash $(SEL)/run_harness.sh elixir 1.0 0
COMPILE_CMD = d=$$(mktemp -d) && elixirc -o $$d $(SEL)/elixir_hns.exs $(SEL)/harness.exs >/dev/null && elixirc -pa $$d -o $$d solution.ex >/dev/null; rc=$$?; rm -rf $$d; exit $$rc

# validate: permanent PASS via empty-stream compare. Real correctness is
# owned by the arena oracle bound to this competition (run_validate.sh).
VALIDATION_N     = $(ARG)
REFERENCE_OUTPUT = /dev/null
