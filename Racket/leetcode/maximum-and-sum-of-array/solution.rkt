#lang racket
(require "../../../selection/nodes.rkt")

(define/contract (maximum-and-sum nums numSlots)
  (-> (listof exact-integer?) exact-integer? exact-integer?)
  (define vnums (list->vector nums))
  (define n (vector-length vnums))
  (define size (arithmetic-shift 1 n))
  (define full (sub1 size))
  (define dp (make-vector size -1))
  (vector-set! dp 0 0)
  (for ([slot (in-range 1 (add1 numSlots))])
    (define ndp (vector-copy dp))
    (for ([mask (in-range size)])
      (define base (vector-ref dp mask))
      (unless (< base 0)
        (for ([i (in-range n)])
          (unless (bitwise-bit-set? mask i)
            (define nm (bitwise-ior mask (arithmetic-shift 1 i)))
            (define v (+ base (bitwise-and (vector-ref vnums i) slot)))
            (when (> v (vector-ref ndp nm)) (vector-set! ndp nm v))
            (for ([j (in-range (add1 i) n)])
              (unless (bitwise-bit-set? mask j)
                (define nm2 (bitwise-ior nm (arithmetic-shift 1 j)))
                (define v2 (+ v (bitwise-and (vector-ref vnums j) slot)))
                (when (> v2 (vector-ref ndp nm2)) (vector-set! ndp nm2 v2))))))))
    (set! dp ndp))
  (if (>= (vector-ref dp full) 0) (vector-ref dp full) 0))

(provide (all-defined-out))
