#lang racket
(require "../../../selection/nodes.rkt")

(define/contract (max-points points)
  (-> (listof (listof exact-integer?)) exact-integer?)
  (define pv (list->vector (map list->vector points)))
  (define n (vector-length pv))
  (define (px i) (vector-ref (vector-ref pv i) 0))
  (define (py i) (vector-ref (vector-ref pv i) 1))
  (if (<= n 2)
      n
      (for/fold ([best 1]) ([i (in-range n)])
        (define slopes (make-hash))
        (for/fold ([best best]) ([j (in-range (+ i 1) n)])
          (define dx0 (- (px j) (px i)))
          (define dy0 (- (py j) (py i)))
          (define g (gcd (abs dx0) (abs dy0)))
          (define dx1 (quotient dx0 g))
          (define dy1 (quotient dy0 g))
          (define-values (dx dy)
            (if (or (< dx1 0) (and (= dx1 0) (< dy1 0)))
                (values (- dx1) (- dy1))
                (values dx1 dy1)))
          (define key (cons dx dy))
          (define cnt (+ 1 (hash-ref slopes key 0)))
          (hash-set! slopes key cnt)
          (max best (+ cnt 1))))))

(provide (all-defined-out))
