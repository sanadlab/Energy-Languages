#lang racket
(require "../../../selection/nodes.rkt")

(define (popcount x)
  (let loop ([x x] [c 0])
    (if (= x 0) c (loop (arithmetic-shift x -1) (+ c (bitwise-and x 1))))))

(define/contract (max-score nums)
  (-> (listof exact-integer?) exact-integer?)
  (define nv (list->vector nums))
  (define m (vector-length nv))
  (define size (arithmetic-shift 1 m))
  (define dp (make-vector size 0))
  (define best 0)
  (for ([mask (in-range size)])
    (define cnt (popcount mask))
    (unless (odd? cnt)
      (define op (+ (quotient cnt 2) 1))
      (for ([i (in-range m)])
        (unless (bitwise-bit-set? mask i)
          (for ([j (in-range (add1 i) m)])
            (unless (bitwise-bit-set? mask j)
              (define nm (bitwise-ior mask (arithmetic-shift 1 i) (arithmetic-shift 1 j)))
              (define val (+ (vector-ref dp mask) (* op (gcd (vector-ref nv i) (vector-ref nv j)))))
              (when (> val (vector-ref dp nm))
                (vector-set! dp nm val)
                (when (> val best) (set! best val)))))))))
  best)

(provide (all-defined-out))
