#lang racket
(require "../../../selection/nodes.rkt")

(define/contract (eventual-safe-nodes graph)
  (-> (listof (listof exact-integer?)) (listof exact-integer?))
  (define gv (list->vector graph))
  (define n (vector-length gv))
  (define rev (make-vector n '()))
  (define outdeg (make-vector n 0))
  (for ([u (in-range n)])
    (for ([v (in-list (vector-ref gv u))])
      (when (and (<= 0 v) (< v n))
        (vector-set! rev v (cons u (vector-ref rev v)))
        (vector-set! outdeg u (+ 1 (vector-ref outdeg u))))))
  (define safe (make-vector n #f))
  (define worklist '())
  (for ([i (in-range n)])
    (when (= (vector-ref outdeg i) 0)
      (set! worklist (cons i worklist))))
  (let loop ()
    (unless (null? worklist)
      (define vtx (car worklist))
      (set! worklist (cdr worklist))
      (vector-set! safe vtx #t)
      (for ([u (in-list (vector-ref rev vtx))])
        (vector-set! outdeg u (- (vector-ref outdeg u) 1))
        (when (= (vector-ref outdeg u) 0)
          (set! worklist (cons u worklist))))
      (loop)))
  (for/list ([i (in-range n)] #:when (vector-ref safe i)) i))

(provide (all-defined-out))
