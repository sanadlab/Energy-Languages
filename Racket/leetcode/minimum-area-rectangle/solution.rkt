#lang racket
(require "../../../selection/nodes.rkt")

(define/contract (min-area-rect points)
  (-> (listof (listof exact-integer?)) exact-integer?)
  (define pv (list->vector points))
  (define n (vector-length pv))
  (define seen (make-hash))
  (for ([p (in-vector pv)])
    (hash-set! seen (+ (* (car p) 50000) (cadr p)) #t))
  (define best +inf.0)
  (for ([i (in-range n)])
    (define pi (vector-ref pv i))
    (define x1 (car pi)) (define y1 (cadr pi))
    (for ([j (in-range (add1 i) n)])
      (define pj (vector-ref pv j))
      (define x2 (car pj)) (define y2 (cadr pj))
      (when (and (not (= x1 x2))
                 (not (= y1 y2))
                 (hash-ref seen (+ (* x1 50000) y2) #f)
                 (hash-ref seen (+ (* x2 50000) y1) #f))
        (define area (* (abs (- x1 x2)) (abs (- y1 y2))))
        (when (< area best) (set! best area)))))
  (if (= best +inf.0) 0 best))

(provide (all-defined-out))
