#lang racket
(require "../../../selection/nodes.rkt")

(define/contract (hit-bricks grid hits)
  (-> (listof (listof exact-integer?)) (listof (listof exact-integer?)) (listof exact-integer?))
  (define m (length grid))
  (define grid-vec (list->vector (map list->vector grid)))
  (define n (if (> m 0) (vector-length (vector-ref grid-vec 0)) 0))
  (define total (* m n))
  (define top total)
  (define parent (build-vector (add1 total) values)) ; parent[x] = x
  (define size (make-vector (add1 total) 1))
  (define (find x)
    (let loop ([x x])
      (if (= (vector-ref parent x) x)
          x
          (begin
            (vector-set! parent x (vector-ref parent (vector-ref parent x)))
            (loop (vector-ref parent x))))))
  (define (union a b)
    (define ra (find a))
    (define rb (find b))
    (unless (= ra rb)
      (let-values ([(ra rb) (if (< (vector-ref size ra) (vector-ref size rb))
                                (values rb ra)
                                (values ra rb))])
        (vector-set! parent rb ra)
        (vector-set! size ra (+ (vector-ref size ra) (vector-ref size rb))))))
  (define (in-bounds? r c) (and (<= 0 r) (< r m) (<= 0 c) (< c n)))
  (define (idx r c) (+ (* r n) c))
  ; working grid: 1 where a brick currently stands
  (define g (make-vector total 0))
  (for ([r (in-range m)])
    (define row (vector-ref grid-vec r))
    (for ([c (in-range (min n (vector-length row)))])
      (when (= (vector-ref row c) 1) (vector-set! g (idx r c) 1))))
  ; erase the hit bricks up-front
  (for ([h (in-list hits)])
    (when (>= (length h) 2)
      (define r (car h)) (define c (cadr h))
      (when (in-bounds? r c) (vector-set! g (idx r c) 0))))
  ; build union-find over the bricks that remain
  (for ([r (in-range m)])
    (for ([c (in-range n)])
      (when (= (vector-ref g (idx r c)) 1)
        (define cur (idx r c))
        (when (= r 0) (union cur top))
        (when (and (> r 0) (= (vector-ref g (idx (sub1 r) c)) 1))
          (union cur (idx (sub1 r) c)))
        (when (and (> c 0) (= (vector-ref g (idx r (sub1 c))) 1))
          (union cur (idx r (sub1 c)))))))
  (define dirs '((1 0) (-1 0) (0 1) (0 -1)))
  (define hits-vec (list->vector hits))
  (define H (vector-length hits-vec))
  (define result (make-vector H 0))
  (for ([i (in-range (sub1 H) -1 -1)])
    (define h (vector-ref hits-vec i))
    (when (>= (length h) 2)
      (define r (car h)) (define c (cadr h))
      (when (and (in-bounds? r c)
                 ; only a brick that originally existed there can fall back
                 (let ([row (vector-ref grid-vec r)])
                   (and (< c (vector-length row)) (= (vector-ref row c) 1))))
        (define before (vector-ref size (find top)))
        (vector-set! g (idx r c) 1)
        (define cur (idx r c))
        (when (= r 0) (union cur top))
        (for ([d (in-list dirs)])
          (define nr (+ r (car d))) (define nc (+ c (cadr d)))
          (when (and (in-bounds? nr nc) (= (vector-ref g (idx nr nc)) 1))
            (union cur (idx nr nc))))
        (define after (vector-ref size (find top)))
        (vector-set! result i (max 0 (- after before 1))))))
  (vector->list result))

(provide (all-defined-out))
