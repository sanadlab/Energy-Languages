#lang racket
(require "../../../selection/nodes.rkt")

(define/contract (min-cost maxTime edges passingFees)
  (-> exact-integer? (listof (listof exact-integer?)) (listof exact-integer?) exact-integer?)
  (define fees (list->vector passingFees))
  (define n (vector-length fees))
  (define INF (arithmetic-shift 1 29))
  (define adj (make-vector n '()))
  (for ([e (in-list edges)])
    (when (>= (length e) 3)
      (define x (car e))
      (define y (cadr e))
      (define w (caddr e))
      (when (and (>= x 0) (< x n) (>= y 0) (< y n) (>= w 0))
        (vector-set! adj x (cons (cons y w) (vector-ref adj x)))
        (vector-set! adj y (cons (cons x w) (vector-ref adj y))))))
  (define dp (build-vector (add1 maxTime) (lambda (_) (make-vector n INF))))
  (vector-set! (vector-ref dp 0) 0 (vector-ref fees 0))
  (define ans INF)
  (for ([t (in-range (add1 maxTime))])
    (define row (vector-ref dp t))
    (for ([u (in-range n)])
      (define cur (vector-ref row u))
      (when (< cur INF)
        (when (and (= u (sub1 n)) (< cur ans))
          (set! ans cur))
        (for ([edge (in-list (vector-ref adj u))])
          (define v (car edge))
          (define w (cdr edge))
          (define nt (+ t w))
          (when (and (<= nt maxTime)
                     (< (+ cur (vector-ref fees v)) (vector-ref (vector-ref dp nt) v)))
            (vector-set! (vector-ref dp nt) v (+ cur (vector-ref fees v))))))))
  (if (>= ans INF) -1 ans))

(provide (all-defined-out))
