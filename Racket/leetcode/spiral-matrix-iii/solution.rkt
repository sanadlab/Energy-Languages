#lang racket
(require "../../../selection/nodes.rkt")

(define/contract (spiral-matrix-iii rows cols rStart cStart)
  (-> exact-integer? exact-integer? exact-integer? exact-integer? (listof (listof exact-integer?)))
  (define total (* rows cols))
  (define res '())
  (define cnt 0)
  (define r rStart)
  (define c cStart)
  (define dr (vector 0 1 0 -1))
  (define dc (vector 1 0 -1 0))
  (when (and (<= 0 r) (< r rows) (<= 0 c) (< c cols))
    (set! res (cons (list r c) res))
    (set! cnt (add1 cnt)))
  (let loop ([step 1] [d 0])
    (when (< cnt total)
      (define d2
        (for/fold ([d d]) ([_ (in-range 2)])
          (for ([_ (in-range step)])
            (set! r (+ r (vector-ref dr (modulo d 4))))
            (set! c (+ c (vector-ref dc (modulo d 4))))
            (when (and (<= 0 r) (< r rows) (<= 0 c) (< c cols))
              (set! res (cons (list r c) res))
              (set! cnt (add1 cnt))))
          (add1 d)))
      (loop (add1 step) d2)))
  (reverse res))

(provide (all-defined-out))
