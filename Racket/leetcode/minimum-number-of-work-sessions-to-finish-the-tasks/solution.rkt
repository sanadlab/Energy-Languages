#lang racket
(require "../../../selection/nodes.rkt")

(define/contract (min-sessions tasks sessionTime)
  (-> (listof exact-integer?) exact-integer? exact-integer?)
  (define tv (list->vector tasks))
  (define n (vector-length tv))
  (define size (arithmetic-shift 1 n))
  (define full (sub1 size))
  (define INF +inf.0)
  (define sessions (make-vector size INF))
  (define used (make-vector size 0))
  (vector-set! sessions 0 1)
  (for ([mask (in-range size)])
    (unless (= (vector-ref sessions mask) INF)
      (for ([i (in-range n)])
        (when (= (bitwise-and mask (arithmetic-shift 1 i)) 0)
          (define nm (bitwise-ior mask (arithmetic-shift 1 i)))
          (define-values (ns nu)
            (if (<= (+ (vector-ref used mask) (vector-ref tv i)) sessionTime)
                (values (vector-ref sessions mask) (+ (vector-ref used mask) (vector-ref tv i)))
                (values (add1 (vector-ref sessions mask)) (vector-ref tv i))))
          (when (or (< ns (vector-ref sessions nm))
                    (and (= ns (vector-ref sessions nm)) (< nu (vector-ref used nm))))
            (vector-set! sessions nm ns)
            (vector-set! used nm nu))))))
  (vector-ref sessions full))

(provide (all-defined-out))
