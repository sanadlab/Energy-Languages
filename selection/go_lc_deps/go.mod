// The module every LeetCode Go solution is built in (selection/harness_go.sh).
// LeetCode's Go (1.23) offers one third-party package, github.com/emirpasic/gods
// v1.18.1, so a solution may import it. Keep go.sum next to this file.
module leetcode

go 1.23

require github.com/emirpasic/gods v1.18.1
